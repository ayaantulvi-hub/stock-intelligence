# Copy to .env. Never commit .env.
# Must match docker-compose.yml, or point at your own PostgreSQL 16 server.
DATABASE_URL=postgresql+psycopg://stockintel:change-me@localhost:5432/stockintel
POSTGRES_PASSWORD=change-me

# Seconds between worker heartbeats, and age at which the worker counts as stale.
WORKER_HEARTBEAT_SECONDS=60
WORKER_STALE_AFTER_SECONDS=180

# Browser origin allowed to call the API.
FRONTEND_ORIGIN=http://localhost:5173
