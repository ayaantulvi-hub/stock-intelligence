# Copy to .env. Never commit .env.
# Must match docker-compose.yml, or point at your own PostgreSQL 16 server.
DATABASE_URL=postgresql+psycopg://stockintel:change-me@localhost:5432/stockintel
POSTGRES_PASSWORD=change-me

# Data sources.
TIINGO_API_TOKEN=
FRED_API_KEY=
SEC_CONTACT_EMAIL=

# Age in seconds at which scheduled updates count as stale. Three days covers weekends.
WORKER_STALE_AFTER_SECONDS=259200

# Protects the dashboard. Required when APP_ENV=production.
DASHBOARD_PASSWORD=

# Browser origin allowed to call the API.
FRONTEND_ORIGIN=http://localhost:5173
